$theme: custom;
$provide-dark-mode: no;
// ============================================================================
// bbeaccess.scss — port of bbeACCESSC_ADA.cls box styling to PreTeXt HTML
//
// Source of truth for every colour below:
//   Fall 2026 Calculus III/Lecture Notes/bbeACCESSC_ADA.cls
// The hex values are copied from that file's own WCAG annotations, so the
// contrast ratios recorded there carry over unchanged.
//
// LOCATION: this file must live under source/, because <css @entry-point> is
// resolved relative to the directory holding main.ptx — not the document root
// that the publication-file docs describe.  Moving it to the project root
// breaks the build with an esbuild "Could not resolve" error.
//
// SCOPE (per request 2026-09-06):
//   * generality / property / activity  — NOT ported (no PreTeXt equivalent)
//   * note                              — merged into the remark palette
//
// NOTE ON NUMBERING: the .cls gives each environment its own
// [auto counter, number within=chapter].  PreTeXt uses one shared "blocks"
// counter and no stylesheet can change that.  These rules restyle the boxes;
// the numbers stay PreTeXt's (Definition 1.1.1, Example 1.1.2, Remark 1.1.3).
//
// !! SCAFFOLDING TODO !!  A theme with @entry-point is expected to pull in
// PreTeXt's base layer before these overrides.  Confirm the correct import
// against the shipped themes in your PreTeXt 2.48.1 install (the Codespace,
// not this Windows checkout) and add it above this line.  Everything below is
// purely additive and does not depend on how that import is spelled.
// ============================================================================


// ---------------------------------------------------------------- palette --
// Frame colours (all AAA against white, per the .cls annotations)
$tealframe:   #1F6068;  // definition, solution      7.16:1
$roseframe:   #7B2D44;  // theorem                   9.13:1
$exampleblue: #005B8E;  // example                   7.27:1  (.cls "magenta")
$bbered:      #AA0000;  // exercise                  7.75:1
$remarkbg:    #F0E8C2;  // remark + note   (yellow!45!white, flat frame+bg)
$bbeblue:     #332288;  // "bbe" label colour        12.17:1 on white

// Body tints (colback = <frame>!12!white, as computed in the .cls comments)
$teal-bg:     #E9F5F3;
$rose-bg:     #F9EDEF;
$example-bg:  #D8E8F1;
$exercise-bg: #F5E0E0;

// Geometry lifted from \tcbset: sharp corners, boxsep=1pt, 1.4pt rules
$rule:        1.4px;
$boxsep:      1pt;

// arev is not a webfont; MathJax will not match the PDF's maths.  The text
// face is reproducible, so at least that much is shared with the PDF.
$bodyfont:    "Comic Sans MS", "Comic Neue", cursive;
$titlefont:   ui-sans-serif, system-ui, "Segoe UI", sans-serif;


// ------------------------------------------------------------------ mixin --
// Reproduces tcolorbox's "attach boxed title to top left" — the title tab
// straddles the top border, flush to the left edge, in the frame colour.
@mixin bbe-box($frame, $bg, $titlecolor: #fff) {
  border: $rule solid $frame;
  border-radius: 0;                    // sharp corners
  background: $bg;
  padding: $boxsep 0.75em 0.75em;
  margin-block: 1.6em 1.1em;
  box-shadow: 2px 2px 4px rgb(0 0 0 / 25%);   // ~ "drop lifted shadow"

  > .heading {
    display: inline-block;
    margin-top: calc(-1 * (0.9em + #{$boxsep} + #{$rule}));
    margin-right: 0;
    margin-bottom: 0.4em;
    margin-left: calc(-0.75em - #{$rule});
    padding: $boxsep 0.55em;
    background: $frame;
    color: $titlecolor;
    font-family: $titlefont;
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.3;
    border-radius: 0;

    .type, .codenumber, .title { color: inherit; }
  }
}


// ------------------------------------------------------------ the blocks --
.definition-like { @include bbe-box($tealframe,   $teal-bg); }
.theorem-like    { @include bbe-box($roseframe,   $rose-bg); }
.example-like    { @include bbe-box($exampleblue, $example-bg); }
.exercise-like   { @include bbe-box($bbered,      $exercise-bg); }

// REMARK + NOTE
// The .cls draws these as flat panels, frame == background, with the label in
// bbe blue rather than white.  Note is a remark-like element in PreTeXt, so
// this single rule covers both — which is the merge that was asked for.
.remark-like {
  @include bbe-box($remarkbg, $remarkbg, $bbeblue);
  // Wrapped in `& {}`: these follow the nested `> .heading` rule inside the
  // mixin, and bare declarations after a nested rule are a Sass deprecation.
  & { box-shadow: none; }              // the .cls note/remark carry no shadow
}

// SOLUTION
// boxrule=0pt with leftrule=1.4pt — a left spine only, no surrounding frame.
.solution-like,
.solution {
  @include bbe-box($tealframe, $teal-bg);
  & {
    border: none;
    border-left: $rule solid $tealframe;
    box-shadow: none;                  // "no shadow" in the .cls
    padding-top: 2ex;                  // top=2ex
  }
}


// ------------------------------------------------------------ typography --
body { font-family: $bodyfont; }


// ----------------------------------------------------------- dark mode ⚠ --
// Every contrast ratio annotated in the .cls is computed against WHITE.  These
// colours are hard-coded light, so a dark theme would invert the page around
// them and void those ratios.  Set provide-dark-mode="no" on <css> in
// publication-web.ptx rather than relying on this block.
@media (prefers-color-scheme: dark) {
  .definition-like, .theorem-like, .example-like,
  .exercise-like, .remark-like, .solution-like, .solution {
    color: #000;
  }
}

        </interactive>
      </figure>

      <figure xml:id="fig-ch02-02-level-curve-b">
        <caption>The level curve obtained by intersecting z equals x squared over 2 plus y squared over 4 with the plane z equals 2.</caption>

        <!-- This interactive is PENDING, it should correspond to 2025_08_06_f7193d1cc61b1e2c50ebg-09-1. -->

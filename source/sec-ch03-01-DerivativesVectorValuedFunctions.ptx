3cos(7pi/2),5cos(7pi/2/2),sin(7pi/2));dashed=undefined&amp;type=window;showfunnot=false;hsrmode=0;nomidpts=true;anaglyph=-1;center=-15.835439836713848,9.898523899187973,7.159474128384735,1;focus=0,0,0,1;up=0.432779588738574,-0.16047775891828026,0.8871013000012102,1;transparent=true;alpha=140;twoviews=false;unlinkviews=false;axisextension=0.7;shownormals=false;shownormalsatpts=false;xaxislabel=x;yaxislabel=y;zaxislabel=z;edgeson=true;faceson=true;showbox=false;showaxes=true;showticks=true;perspective=true;centerxpercent=0.5;centerypercent=0.5;rotationsteps=30;autospin=true;xygrid=false;yzgrid=false;xzgrid=false;gridsonbox=true;gridplanes=false;gridcolor=rgb(128,128,128);lastaddedsurfaceactive=true;disabletrace=false;activefun=-1;xmin=-4;xmax=4;ymin=-4;ymax=4;zmin=-4;zmax=4;xscale=2;yscale=2;zscale=2;zcmin=-8;zcmax=8;xscalefactor=1;yscalefactor=1;zscalefactor=1;tracemode=0;keep2d=false;zoom=0.45">
      <instructions>
        <p>
          Drag with the mouse to rotate the surface. You can open the plot in a new page from here: <url href="https://c3d.libretexts.org/CalcPlot3D/index.html?type=spacecurve;spacecurve=curve;curvename=r_%7B2%7D;x=3%20cos(t);y=5%20cos(t/2);z=sin(t);visible=true;width=2;view=0;tmin=-10;tmax=10;tsteps=500;color=rgb(30,136,229);showtrace=false;tval=2.2799999999999994;constcol=false;twod=false;arrows=0;showpt=true;traceptsize=4;trace=true;vel=true;acc=true;veceqs=true;osc=false;k=false;showtorsion=false;repeat=false;bounce=false;dashed=false;tanline=false;dropcurtain=false;showtvector=true;shownvector=true;showbvector=false;showtnbeqs=false;showtnblabels=false;showoscplane=false;showrectplane=false;shownormplane=false;optimizecurve=true;maxjointangle=10&amp;type=vector;vector=%3C-3%20sin(0),%20-5/2%20sin(0/2),%20cos(0)%3E;visible=true;color=rgb(216,27,96);size=2;initialpt=(3cos(0),5cos(0/2),sin(0));dashed=false&amp;type=vector;vector=%3C-3%20sin(pi/2),%20-5/2%20sin(pi/2/2),%20cos(pi/2)%3E;visible=true;color=rgb(216,27,96);size=2;initialpt=(3cos(pi/2),5cos(pi/2/2),sin(pi/2));dashed=false&amp;type=vector;vector=%3C-3%20sin(pi),%20-5/2%20sin(pi/2),%20cos(pi)%3E;visible=true;color=rgb(216,27,96);size=2;initialpt=(3cos(pi),5cos(pi/2),sin(pi));dashed=false&amp;type=vector;vector=%3C-3%20sin(3pi/2),%20-5/2%20sin(3pi/2/2),%20cos(3pi/2)%3E;visible=true;color=rgb(216,27,96);size=2;initialpt=(3cos(3pi/2),5cos(3pi/2/2),sin(3pi/2));dashed=false&amp;type=vector;vector=%3C-3%20sin(4pi/2),%20-5/2%20sin(4pi/2/2),%20cos(4pi/2)%3E;visible=true;color=rgb(216,27,96);size=2;initialpt=(3cos(4pi/2),5cos(4pi/2/2),sin(4pi/2));dashed=false&amp;type=vector;vector=%3C-3%20sin(5pi/2),%20-5/2%20sin(5pi/2/2),%20cos(5pi/2)%3E;visible=true;color=rgb(216,27,96);size=2;initialpt=(3cos(5pi/2),5cos(5pi/2/2),sin(5pi/2));dashed=false&amp;type=vector;vector=%3C-3%20sin(6pi/2),%20-5/2%20sin(6pi/2/2),%20cos(6pi/2)%3E;visible=true;color=rgb(216,27,96);size=2;initialpt=(3cos(6pi/2),5cos(6pi/2/2),sin(6pi/2));dashed=false&amp;type=vector;vector=%3C-3%20sin(7pi/2),%20-5/2%20sin(7pi/2/2),%20cos(7pi/2)%3E;visible=true;color=rgb(216,27,96);size=2;initialpt=(3cos(7pi/2),5cos(7pi/2/2),sin(7pi/2));dashed=undefined&amp;type=window;showfunnot=false;hsrmode=0;nomidpts=true;anaglyph=-1;center=-15.835439836713848,9.898523899187973,7.159474128384735,1;focus=0,0,0,1;up=0.432779588738574,-0.16047775891828026,0.8871013000012102,1;transparent=true;alpha=140;twoviews=false;unlinkviews=false;axisextension=0.7;shownormals=false;shownormalsatpts=false;xaxislabel=x;yaxislabel=y;zaxislabel=z;edgeson=true;faceson=true;showbox=false;showaxes=true;showticks=true;perspective=true;centerxpercent=0.5;centerypercent=0.5;rotationsteps=30;autospin=true;xygrid=false;yzgrid=false;xzgrid=false;gridsonbox=true;gridplanes=false;gridcolor=rgb(128,128,128);lastaddedsurfaceactive=true;disabletrace=false;activefun=-1;xmin=-4;xmax=4;ymin=-4;ymax=4;zmin=-4;zmax=4;xscale=2;yscale=2;zscale=2;zcmin=-8;zcmax=8;xscalefactor=1;yscalefactor=1;zscalefactor=1;tracemode=0;keep2d=false;zoom=0.737" target="_blank" rel="noopener noreferrer">link to the plot</url>
        </p>
      </instructions>
      <static>
        <image source="/images/2025_09_10_1e5944898def0022a5afg-5.png">
          <shortdescription>The position vector r of t with coordinates x = 3 cosine of t, y = 5 cosine of t over 2, z = sine of t, tracing a figure eight, with a tangent vector shown at a point on the curve.</shortdescription>
          <description>
            <p>The position vector <m>\vec{r}(t)=\left\langle 3\cos (t), 5\cos\left(\frac{t}{2}\right), \sin (t)\right\rangle</m>, tracing a figure eight, with a tangent vector shown at a point on the curve.</p>
          </description>
        </image>
      </static>
    </interactive>
  </figure>

  <definition>
    <statement>
      <p>
        We define the unit tangent vector to the graph of <m>\vec{r}(t)</m>
        at <m>t=t_{0}</m> as
        <md>
          \vec{T}\left(t_{0}\right)=\frac{\vec{r}^{\prime}\left(t_{0}\right)}{\left|\vec{r}^{\prime}\left(t_{0}\right)\right|}, \quad\left|\vec{r}^{\prime}\left(t_{0}\right)\right| \neq 0
        </md>
      </p>
    </statement>
  </definition>

  <example xml:id="example-ch03-01-ex-7-4">
    <statement>
      <p>
        Given <m>\vec{r}(t)=\left\langle\sqrt{t}, \ln (t)\right\rangle, t \gt 0</m>,
        find:
      </p>

      <p>
        (a) The tangent vector to the graph of <m>\vec{r}(t)</m> at the
        point <m>\left(1, 0\right)</m>.
      </p>

      <p>
        (b) The unit tangent vector to the graph of <m>\vec{r}(t)</m> for
        arbitrary <m>t</m>.
      </p>

      <figure xml:id="fig-ch03-01-ex-7-4">
        <caption>The curve traced by the vector r of t with coordinates x = the square root of t, y = the natural log of t.</caption>

        <!-- This interactive is PENDING, it should correspond to 2025_09_10_1e5944898def0022a5afg-6. -->
        <interactive xml:id="interactive-ch03-01-ex-7-4" width="85%" aspect="4:3" iframe="https://www.desmos.com/calculator/vqavop8m24?embed">
          <instructions>
            <p>The graph above shows only the plot; you can drag and zoom it. To see the expressions behind it, or to save a copy and create your own version of the graph, open it in a new page from here: <url href="https://www.desmos.com/calculator/vqavop8m24" target="_blank" rel="noopener noreferrer">link to the graph</url></p>
          </instructions>
          <static>
            <image source="/images/2025_09_10_1e5944898def0022a5afg-6.png">
              <shortdescription>The curve traced by the vector r of t with coordinates x = the square root of t, y = the natural log of t.</shortdescription>
              <description>
                <p>The curve traced by the vector <m>\vec{r}(t)=\left\langle\sqrt{t}, \ln (t)\right\rangle</m>.</p>
              </description>
            </image>
          </static>
        </interactive>
      </figure>
    </statement>

    <solution>
      <p>
        First we find the <m>t</m>-value corresponding to the point
        <m>(1,0)</m>: we need <m>\sqrt{t} = 1</m> and <m>\ln(t) = 0</m>,
        and both equations give <m>t=1</m>. Differentiating componentwise:
        <md>
          \vec{r}'(t) = \left\langle \frac{1}{2\sqrt{t}}, \frac{1}{t} \right\rangle
        </md>
        so the tangent vector at the point <m>(1,0)</m> is
        <md>
          \vec{r}'(1) = \left\langle \frac{1}{2}, 1 \right\rangle
        </md>
      </p>
    </solution>

    <solution>
      <p>
        For <m>t \gt 0</m> the magnitude of <m>\vec{r}'(t)</m> is
        <md>
          |\vec{r}'(t)| = \sqrt{\left( \frac{1}{2\sqrt{t}} \right)^2+\left( \frac{1}{t} \right)^2} = \sqrt{\frac{1}{4t}+\frac{1}{t^2}} = \sqrt{\frac{t+4}{4t^2}} = \frac{\sqrt{t+4}}{2t}
        </md>
        Hence the unit tangent vector is
        <md>
          \vec{T}(t) = \frac{\vec{r}'(t)}{|\vec{r}'(t)|} = \frac{2t}{\sqrt{t+4}}\left\langle \frac{1}{2\sqrt{t}}, \frac{1}{t} \right\rangle = \left\langle \frac{\sqrt{t}}{\sqrt{t+4}}, \frac{2}{\sqrt{t+4}} \right\rangle
        </md>
        As a check,
        <m>|\vec{T}(t)|^2 = \frac{t}{t+4}+\frac{4}{t+4} = 1</m>, so
        <m>\vec{T}(t)</m> is indeed a unit vector.
      </p>
    </solution>
  </example>

  <!--Graph of $\mathbf{r}(t)=\left\langle\sqrt{t}, \frac{t^{2}}{6}\right\rangle$ for $0<t \leq 2$, and $\mathbf{r}^{\prime}(1)$-->
  <!--Knowledge Check.-->

  <note>
    <title>Velocity and Acceleration Vectors</title>

    <p>
      Given a differentiable curve <m>\vec{r}(t)</m>, the vector
      <m>\vec{r}^{\prime}(t)</m> has an important physical interpretation:
    </p>

    <p>
      <ul>
        <li>
          <p>
            <m>\left|\vec{r}^{\prime}\left(t_{0}\right)\right|</m> gives the
            speed of a particle traveling on <m>\vec{r}(t)</m> at
            <m>t=t_{0}</m>.
          </p>
        </li>

        <li>
          <p>
            <m>\frac{\vec{r}^{\prime}\left(t_{0}\right)}{\left|\vec{r}^{\prime}\left(t_{0}\right)\right|}</m>
            gives the direction of motion of a particle traveling on
            <m>\vec{r}(t)</m> at <m>t=t_{0}</m>.
          </p>
        </li>
      </ul>
    </p>
  </note>

  <definition>
    <title>Velocity and Acceleration Vectors</title>

    <statement>
      <p>
        Suppose <m>\vec{r}(t)</m> is a twice differentiable function
        representing the position of a particle at time <m>t</m>. Then
      </p>

      <p>
        <ul>
          <li>
            <p>
              <m>\vec{r}^{\prime}(t)</m> is the velocity vector of the
              particle at time <m>t</m>.
            </p>
          </li>

          <li>
            <p>
              <m>\vec{r}^{\prime \prime}(t)</m> is the acceleration vector
              of the particle at time <m>t</m>.
            </p>
          </li>
        </ul>
      </p>
    </statement>
  </definition>

  <example xml:id="example-ch03-01-ex-7-5">
    <statement>
      <p>
        Suppose that the position of a particle is given by
        <m>\vec{r}(t)=\langle t^2, \sqrt{t}, \ln (t)\rangle</m>,
        <m>t \gt 0</m>. Find:
      </p>

      <p>(a) The velocity vector of the particle at <m>t=1</m>.</p>

      <p>(b) The speed of the particle at <m>t=1</m>.</p>

      <p>(c) The direction of motion of the particle at time <m>t=1</m>.</p>
    </statement>

    <solution>
      <p>
        Differentiating componentwise, the velocity vector at time <m>t</m>
        is
        <md>
          \vec{r}'(t) = \left\langle 2t, \frac{1}{2\sqrt{t}}, \frac{1}{t} \right\rangle
        </md>
        so at <m>t=1</m>
        <md>
          \vec{r}'(1) = \left\langle 2, \frac{1}{2}, 1 \right\rangle
        </md>
      </p>
    </solution>

    <solution>
      <p>
        The speed is the magnitude of the velocity vector:
        <md>
          |\vec{r}'(1)| = \sqrt{2^2+\left( \frac{1}{2} \right)^2+1^2} = \sqrt{\frac{16}{4}+\frac{1}{4}+\frac{4}{4}} = \sqrt{\frac{21}{4}} = \frac{\sqrt{21}}{2}
        </md>
      </p>
    </solution>

    <solution>
      <p>
        The direction of motion is the unit vector in the direction of the
        velocity vector:
        <md>
          \frac{\vec{r}'(1)}{|\vec{r}'(1)|} = \frac{2}{\sqrt{21}}\left\langle 2, \frac{1}{2}, 1 \right\rangle = \left\langle \frac{4}{\sqrt{21}}, \frac{1}{\sqrt{21}}, \frac{2}{\sqrt{21}} \right\rangle
        </md>
      </p>
    </solution>
  </example>

  <example xml:id="example-ch03-01-ex-7-6">
    <statement>
      <p>
        Using the parametrization of the unit circle
        <m>\vec{r}(t)=\langle\sin (t), \cos (t)\rangle</m>,
        <m>0 \leq t \leq 2 \pi</m>, find all points on the unit circle at
        which its tangent vector is orthogonal to <m>\vec{r}(t)</m>.
      </p>
    </statement>

    <solution>
      <p>
        The tangent vector is
        <m>\vec{r}'(t) = \langle \cos(t), -\sin(t) \rangle</m>. Checking
        orthogonality with the dot product:
        <md>
          \vec{r}(t) \cdot \vec{r}'(t) = \sin(t)\cos(t)+\cos(t)\left( -\sin(t) \right) = 0
        </md>
        The dot product equals 0 for every value of <m>t</m>, so the tangent
        vector is orthogonal to <m>\vec{r}(t)</m> at every point of the unit
        circle. This matches the geometric fact that a tangent line to a
        circle is always perpendicular to the radius drawn to the point of
        tangency <ndash/> and here <m>\vec{r}(t)</m> is exactly that radius.
      </p>
    </solution>
  </example>

</section>

<?xml version="1.0" encoding="UTF-8"?>

<!-- CLAUDE 2026-09-06: publication file for the "web" (html) target.          -->
<!-- Added so that elements carrying component="web" are built and elements   -->
<!-- carrying component="print" are dropped.  Everything with no @component   -->
<!-- at all is unaffected and appears in every version.                       -->
<!--                                                                          -->
<!-- The only real (uncommented) setting in the original publication.ptx was   -->
<!-- the generated-assets directory, reproduced below.  publication.ptx itself -->
<!-- is untouched and still holds the full commented reference of options.     -->
<!-- See REVERT.md at the project root to undo.                                -->

<publication>
  <source>
    <directories generated="../generated-assets" />
    <version include="web" />
  </source>

  <numbering>
    <!-- The divisions element describes the numbering of divisions.   -->
    <!-- @level is the deepest division that gets a number, 0 through  -->
    <!-- 6 (chapter, section, subsection, and so on); it is also the   -->
    <!-- maximum for every level below.  The default depends on the    -->
    <!-- document type.  @chapter-start gives the number of the first  -->
    <!-- chapter (not available with structural parts).                -->
    <!-- @part-structure is "decorative" (the default) or              -->
    <!-- "structural"; the latter restarts chapter numbering within    -->
    <!-- each part.  Parts only matter if your book has them.          -->
      <!--<divisions level="2" chapter-start="1" part-structure="decorative" />-->

    <!-- How many levels deep the numbering of these items runs.  Values -->
    <!-- may not exceed the divisions @level above.  Defaults depend on  -->
    <!-- the type of document.                                           -->
      <!--<blocks level="2" />-->
      <!--<equations level="2" />-->
      <!--<footnotes level="2" />-->

    <!-- By default the "blocks" sequence above also numbers project-like  -->
    <!-- items, figure-like items (figure/table/listing/list), inline      -->
    <!-- exercises, and open problems.  Set @distinct="yes" (the default   -->
    <!-- is "no") to give one of these groups its own independent sequence -->
    <!-- of serial numbers, in which case its own @level applies.  While a -->
    <!-- group shares the blocks count, its @level is ignored.             -->
      <!--<projects distinct="no" level="2" />-->
      <figures distinct="yes" level="2" />
      <!--<exercises distinct="no" level="2" />-->
      <!--<openproblems distinct="no" level="2" />-->
  </numbering>

</publication>
